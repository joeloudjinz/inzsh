# InZsh — README screenshot: the honest degraded case — 256 colours
# One prompt in the pinned fixture environment, photographed. `tools/tape-run.zsh` wraps it.

Output demo-out/shot-256.gif

Set Shell bash
Set Width 1000
Set Height 200
Set FontSize 20
Set FontFamily "MesloLGSDZ Nerd Font Mono"
Set Framerate 24
Set Padding 16
Set Theme "Builtin Dark"

Hide
Type "s=${TMPDIR:-/tmp}; s=${s%/}/inzsh-tape; HOME=$s ZDOTDIR=$s HOST=joeinz-pc TAPE_USER=joeinz TZ=Asia/Riyadh INZSH_SALAH_LAT=21.4225 INZSH_SALAH_LON=39.8262 INZSH_PRESET= INZSH_COLOR_DEPTH=256 exec zsh -d -i"
Enter
Wait+Screen /Maghrib/
Show
Wait+Screen /→/
Sleep 1.5s
