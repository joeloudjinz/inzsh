#!/usr/bin/env zsh
# Pre-commit: syntax-check staged zsh sources; block private data.
# Activated via `git config core.hooksPath tools/hooks` (make setup).
emulate -L zsh
setopt no_unset pipe_fail

local -a staged
staged=(${(f)"$(git diff --cached --name-only --diff-filter=ACM)"})
(( $#staged )) || exit 0

# zsh -n over staged zsh sources
local -a zsh_files
zsh_files=(${(M)staged:#*.zsh} ${(M)staged:#*.zsh-theme})
local f
for f in $zsh_files; do
  if ! zsh -n -- "$f"; then
    print -u2 -- "pre-commit: syntax error in $f"
    exit 1
  fi
done

# secret scan, when gitleaks is installed (make setup installs it)
if (( $+commands[gitleaks] )); then
  if ! gitleaks protect --staged --no-banner; then
    print -u2 -- "pre-commit: gitleaks flagged staged content"
    exit 1
  fi
fi

# coordinate-looking pairs — examples must use neutral data (Mecca placeholder)
local coord_pattern='[0-9]{1,2}\.[0-9]{4,}[, ]+ *-?[0-9]{1,3}\.[0-9]{4,}'
local hits
hits=$(git diff --cached -U0 -- . | grep -E '^\+' | grep -E "$coord_pattern" | grep -Fv '21.4225' || true)
if [[ -n $hits ]]; then
  print -u2 -- "pre-commit: possible real coordinates staged — use the Mecca placeholder (21.4225, 39.8262):"
  print -u2 -- "$hits"
  exit 1
fi

exit 0
